NODE_ENV=production
PORT=5000

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/ncr?appName=Cluster0
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=7

CLIENT_ORIGINS=https://propertyinncr.com,https://www.propertyinncr.com
# Public URL of this API (used to build upload links). Example: https://api.propertyinncr.com
PUBLIC_API_URL=

# true = the OTP is returned in the API response (dev only!). Keep false in production.
OTP_DEV_MODE=false

# Optional: called (POST) when content is published so the website can be rebuilt / re-rendered.
# Example: a GitHub "workflow_dispatch" URL or your own deploy hook.
REBUILD_WEBHOOK_URL=
REBUILD_WEBHOOK_TOKEN=

# Optional first admin (created by `npm run seed` if no admin exists)
ADMIN_PHONE=8619930583
ADMIN_NAME=Admin User
