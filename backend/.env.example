# Copy to backend/.env on the server (and locally) and fill in. NEVER commit the real .env.
NODE_ENV=production
# The API listens on 127.0.0.1:PORT. It must be a port NO other program on the server uses (check: ss -ltnp | grep :5120).
# nginx follows it automatically: deploy/render-nginx-snippet.sh builds the proxy config from this value.
PORT=5120

# MongoDB Atlas connection string (Atlas → Database → Connect → Drivers). Contains the password → secret.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/ncr?appName=Cluster0

# Signs login sessions: a long random string. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=7

# Websites allowed to call the API (CORS + CSRF check). The site and API share one origin behind nginx.
CLIENT_ORIGINS=https://propertyinncr.com,https://www.propertyinncr.com

# nginx sits in front of the API: trust one proxy so the real visitor IP is used (rate limits, consent records)
TRUST_PROXY=1

# Only for a separate API domain. Leave empty when nginx serves /api and /uploads on the same domain.
PUBLIC_API_URL=

# true = the OTP is returned in the API response (development only). The server refuses to start in production if true.
OTP_DEV_MODE=false
OTP_LENGTH=6

# When the admin publishes content, the website is rebuilt automatically (debounced, no downtime).
# This runs on the server; adjust the path if the project lives elsewhere.
REBUILD_COMMAND=cd /var/www/propertyinncr.com && npm run release
# (alternative: REBUILD_WEBHOOK_URL / REBUILD_WEBHOOK_TOKEN to call a deploy hook instead)

# First admin account (created automatically if no admin exists). Log in with an OTP sent to this number.
ADMIN_PHONE=8619930583
ADMIN_NAME=Admin User
